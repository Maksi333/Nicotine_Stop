<?xml version="1.0" encoding="UTF-8" ?>
<!-- SnusStop shared styles. Colors come from the active theme dictionary via DynamicResource. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Page background follows the theme -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Default label: Nunito, ink, 15px -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Nunito" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="Overline" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBlack" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{DynamicResource Faint}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBlack" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBlack" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="TabTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBlack" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoExtraBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBlack" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoBold" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="FaintLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="NunitoExtraBold" />
        <Setter Property="TextColor" Value="{DynamicResource Faint}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Standard white card with hairline border -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Card}" />
        <Setter Property="Stroke" Value="{DynamicResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="18" />
        </Setter>
    </Style>

</ResourceDictionary>
