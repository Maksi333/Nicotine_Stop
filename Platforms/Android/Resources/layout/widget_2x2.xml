<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- ImageView, not View: RemoteViews only inflates @RemoteView-annotated classes,
             and android.view.View is not one of them. -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:background="@drawable/widget_dot" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="NICOTINE-FREE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="0d 0h"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/widget_ink" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/w_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0 kr"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary" />
    </LinearLayout>
</LinearLayout>
