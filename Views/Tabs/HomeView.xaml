<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Nicotine_Stop.Controls"
             x:Class="Nicotine_Stop.Views.Tabs.HomeView"
             x:Name="Root">

    <ContentView.Resources>
        <controls:StarFractionConverter x:Key="Star" />
        <controls:InverseBoolConverter x:Key="InvBool" />
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid Padding="20,10,20,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenSettings" />
                </Grid.GestureRecognizers>
                <controls:PuffMascot Grid.Column="0" Diameter="40" Cheeks="True" Float="True" VerticalOptions="Center" InputTransparent="True" />
                <Label Grid.Column="1" Text="{Binding GreetingName, StringFormat='Hey {0} 👋'}"
                       FontFamily="NunitoBlack" FontSize="20" TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{DynamicResource GoldTint}"
                        StrokeShape="RoundRectangle 12" Padding="12,6" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                        <Label Text="{Binding LevelNumber, StringFormat='LVL {0}'}" FontFamily="NunitoBlack" FontSize="13"
                               TextColor="{DynamicResource GoldText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Ring hero -->
            <Grid Padding="20,6,20,0" HorizontalOptions="Center">
                <controls:ProgressRing WidthRequest="232" HeightRequest="232" StrokeWidth="17"
                                       Progress="{Binding RingProgress}"
                                       TrackColor="{DynamicResource Track}" FillColor="{DynamicResource PrimaryText}" />
                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="NICOTINE-FREE" FontFamily="NunitoBlack" FontSize="10.5" CharacterSpacing="1.5"
                           TextColor="{DynamicResource Faint}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Dd}" FontFamily="NunitoBlack" FontSize="52" TextColor="{DynamicResource Ink}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="days" FontFamily="NunitoExtraBold" FontSize="14" TextColor="{DynamicResource Muted}"
                           HorizontalTextAlignment="Center" Margin="0,-4,0,0" />
                    <Label Text="{Binding Ticker}" FontFamily="NunitoBlack" FontSize="16"
                           TextColor="{DynamicResource PrimaryText}" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Grid>

            <!-- Milestone chip -->
            <Border StrokeThickness="1.5" BackgroundColor="{DynamicResource Card}" Stroke="{DynamicResource CardBorder}"
                    StrokeShape="RoundRectangle 14" Padding="14,8" HorizontalOptions="Center" Margin="0,16,0,0">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="🏆" FontSize="15" VerticalOptions="Center" />
                    <Label VerticalOptions="Center" FontFamily="NunitoExtraBold" FontSize="13" TextColor="{DynamicResource Muted}">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} until {1} free">
                                <Binding Path="MilestoneLeftLabel" />
                                <Binding Path="MilestoneTitle" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
            </Border>

            <!-- Stat cards -->
            <Grid Padding="20,14,20,0" ColumnDefinitions="1.2*,*,*" ColumnSpacing="10">
                <controls:StatCard Grid.Column="0" Emoji="💰"
                                   Value="{Binding MoneyStr}" Caption="saved"
                                   ValueColor="{DynamicResource PrimaryText}" />
                <controls:StatCard Grid.Column="1" Emoji="🚫" Value="{Binding PouchesAvoidedStr}" Caption="{Binding SkippedCaption}" />
                <controls:StatCard Grid.Column="2" Emoji="🔥" Value="{Binding StreakStr}" Caption="day streak"
                                   ValueColor="{DynamicResource Flame}" />
            </Grid>

            <!-- XP card -->
            <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 18" Padding="16,14" Margin="20,12,20,0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding LevelLabel}" FontFamily="NunitoBlack" FontSize="14"
                               TextColor="{DynamicResource Ink}" />
                        <Label Grid.Column="1" Text="{Binding XpText}" FontFamily="NunitoExtraBold" FontSize="12"
                               TextColor="{DynamicResource Faint}" VerticalOptions="Center" />
                    </Grid>
                    <Border HeightRequest="14" StrokeThickness="0" BackgroundColor="{DynamicResource GoldTrack}"
                            StrokeShape="RoundRectangle 7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding XpFraction, Converter={StaticResource Star}}" />
                                <ColumnDefinition Width="{Binding XpFraction, Converter={StaticResource Star}, ConverterParameter=rem}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource Gold}" StrokeThickness="0" StrokeShape="RoundRectangle 7" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0" BackgroundColor="{DynamicResource Mint}" StrokeShape="RoundRectangle 10"
                            Padding="10,5" HorizontalOptions="Start" IsVisible="{Binding CheckedIn}">
                        <Label Text="✓ Daily check-in done · +10 XP" FontFamily="NunitoExtraBold" FontSize="12"
                               TextColor="{DynamicResource PrimaryText}" />
                    </Border>
                    <controls:ChunkyButton Text="Check in today · +10 XP" ButtonHeight="44" FontSize="14"
                                           Fill="{DynamicResource Primary}" ShadowColor="{DynamicResource PrimaryPressed}"
                                           Command="{Binding CheckInCommand}" IsVisible="{Binding CheckedIn, Converter={StaticResource InvBool}}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="16" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
