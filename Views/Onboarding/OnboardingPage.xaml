<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Nicotine_Stop.Controls"
             x:Class="Nicotine_Stop.Views.Onboarding.OnboardingPage"
             x:Name="Root">

    <ContentPage.Resources>
        <controls:IntEqualConverter x:Key="IsStep" />
        <controls:StarFractionConverter x:Key="Star" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Progress header (steps 1–5) -->
        <Grid Grid.Row="0" IsVisible="{Binding ShowProgressHeader}"
              Padding="16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
            <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                    BackgroundColor="{DynamicResource Mint}"
                    StrokeShape="RoundRectangle 20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="‹" FontFamily="NunitoExtraBold" FontSize="22"
                       TextColor="{DynamicResource Muted}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Border Grid.Column="1" HeightRequest="12" StrokeThickness="0"
                    BackgroundColor="#E3EEE7" StrokeShape="RoundRectangle 6"
                    VerticalOptions="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ProgressFraction, Converter={StaticResource Star}}" />
                        <ColumnDefinition Width="{Binding ProgressFraction, Converter={StaticResource Star}, ConverterParameter=rem}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BackgroundColor="#14B36B" StrokeThickness="0"
                            StrokeShape="RoundRectangle 6" />
                </Grid>
            </Border>

            <Label Grid.Column="2" Text="{Binding StepLabel}" Style="{StaticResource FaintLabel}"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Step content -->
        <Grid Grid.Row="1">

            <!-- ══ 0 · Welcome (1a) ══ -->
            <Grid Padding="24,0,24,16" RowDefinitions="*,Auto,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=0}">
                <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center">
                    <controls:PuffMascot Diameter="120" Cheeks="True" Float="True" HorizontalOptions="Center" />
                    <Label Text="SNUSSTOP" Style="{StaticResource Overline}" CharacterSpacing="2"
                           TextColor="{DynamicResource PrimaryText}" HorizontalOptions="Center" Margin="0,20,0,0" />
                    <Label Text="{Binding QuitHeadline}" Style="{StaticResource H1}"
                           HorizontalTextAlignment="Center" Margin="0,10,0,0" />
                    <Label Text="Track your streak, watch your savings grow, and beat cravings one level at a time."
                           FontFamily="Nunito" FontSize="16" TextColor="{DynamicResource Muted}"
                           HorizontalTextAlignment="Center" Margin="0,14,0,0" MaximumWidthRequest="300" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Row="1" Spacing="7" HorizontalOptions="Center" Padding="0,14,0,18">
                    <BoxView WidthRequest="20" HeightRequest="8" CornerRadius="4" Color="#14B36B" />
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#D7E6DC" />
                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#D7E6DC" />
                </HorizontalStackLayout>

                <controls:ChunkyButton Grid.Row="2" Text="Let's do this" Command="{Binding NextCommand}"
                                       Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 1 · Name (1b) ══ -->
            <Grid Padding="0" RowDefinitions="*,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=1}">
                <VerticalStackLayout Grid.Row="0" Padding="24,22,24,0" Spacing="8">
                    <Label Text="What should we call you?" Style="{StaticResource H1}" FontSize="28" />
                    <Label Text="Just a first name — this stays on your phone."
                           FontFamily="Nunito" FontSize="15" TextColor="{DynamicResource Muted}" />
                    <Border HeightRequest="60" Margin="0,18,0,0" Stroke="#14B36B" StrokeThickness="2.5"
                            BackgroundColor="{DynamicResource Card}" StrokeShape="RoundRectangle 18" Padding="14,0">
                        <Entry Text="{Binding Name}" Placeholder="Your name" FontFamily="NunitoExtraBold"
                               FontSize="19" TextColor="{DynamicResource Ink}" VerticalOptions="Center"
                               ReturnType="Next" />
                    </Border>
                </VerticalStackLayout>
                <controls:ChunkyButton Grid.Row="1" Margin="20,12" Text="Continue"
                                       Command="{Binding NextCommand}" Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 2 · Habits (1c) ══ -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=2}">
                <VerticalStackLayout Grid.Row="0" Padding="24,22,24,0" Spacing="8">
                    <Label Style="{StaticResource H1}" FontSize="28">
                        <Label.Text><MultiBinding StringFormat="How much do you use, {0}?">
                            <Binding Path="GreetingName" /></MultiBinding></Label.Text>
                    </Label>
                    <Label Text="No judgment — this just makes your savings math accurate."
                           FontFamily="Nunito" FontSize="15" TextColor="{DynamicResource Muted}" />

                    <!-- What they're quitting. Sits here because it re-labels the steppers below it. -->
                    <controls:SegmentedControl Margin="0,16,0,0" Option1="Snus" Option2="Cigarettes"
                                               SelectedIndex="{Binding AddictionIndex}" />

                    <Border Style="{StaticResource Card}" Padding="18,16" StrokeShape="RoundRectangle 20" Margin="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding UnitsPerDayLabel}" FontFamily="NunitoExtraBold" FontSize="15" TextColor="{DynamicResource Ink}" />
                                <Label Text="On a typical day" FontFamily="NunitoSemiBold" FontSize="12.5" TextColor="{DynamicResource Faint}" />
                            </VerticalStackLayout>
                            <controls:Stepper Grid.Column="1" Value="{Binding PouchesPerDay}" MinValue="1" MaxValue="40" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding UnitsPerContainerLabel}" FontFamily="NunitoExtraBold" FontSize="15" TextColor="{DynamicResource Ink}" />
                                <Label Text="Check the label" FontFamily="NunitoSemiBold" FontSize="12.5" TextColor="{DynamicResource Faint}" />
                            </VerticalStackLayout>
                            <controls:Stepper Grid.Column="1" Value="{Binding PouchesPerCan}" MinValue="1" MaxValue="50" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{DynamicResource Mint}" StrokeThickness="0" Padding="14,12"
                            StrokeShape="RoundRectangle 16">
                        <HorizontalStackLayout Spacing="10">
                            <controls:PuffMascot Diameter="28" VerticalOptions="Center" />
                            <Label FontFamily="NunitoBold" FontSize="13.5" TextColor="#2E5C4B" VerticalOptions="Center"
                                   MaximumWidthRequest="260" Text="{Binding ContainersPerWeekLine}" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <controls:ChunkyButton Grid.Row="1" Margin="20,12,20,18" Text="Continue"
                                       Command="{Binding NextCommand}" Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 3 · Cost (1d) ══ -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=3}">
                <VerticalStackLayout Grid.Row="0" Padding="24,22,24,0" Spacing="8">
                    <Label Text="{Binding ContainerCostQuestion}" Style="{StaticResource H1}" FontSize="28" />
                    <Label Text="{Binding ContainerSavingsLine}"
                           FontFamily="Nunito" FontSize="15" TextColor="{DynamicResource Muted}" />

                    <Border HeightRequest="72" Margin="0,18,0,0" Stroke="#14B36B" StrokeThickness="2.5"
                            BackgroundColor="{DynamicResource Card}" StrokeShape="RoundRectangle 20" Padding="20,0">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Entry Grid.Column="0" Text="{Binding CanPrice}" Keyboard="Numeric" WidthRequest="120"
                                   FontFamily="NunitoBlack" FontSize="34" TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CurrencySymbol}" FontFamily="NunitoExtraBold"
                                   FontSize="18" TextColor="{DynamicResource Faint}" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="{Binding PerContainerLabel}" FontFamily="NunitoBold" FontSize="13"
                                   TextColor="{DynamicResource Faint}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="CURRENCY" Style="{StaticResource Overline}" Margin="0,14,0,0" />
                    <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CurrencyChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1.5" Stroke="{DynamicResource CardBorder}"
                                        BackgroundColor="{DynamicResource Card}" Padding="18,10" StrokeShape="RoundRectangle 14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectCurrencyCommand, Source={x:Reference Root}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Selected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#14B36B" />
                                            <Setter Property="Stroke" Value="#14B36B" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Name}" FontFamily="NunitoExtraBold" FontSize="14"
                                           TextColor="{DynamicResource Muted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Selected}" Value="True">
                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="{DynamicResource GoldTint}" StrokeThickness="0" Padding="16,12"
                            StrokeShape="RoundRectangle 16" Margin="0,16,0,0">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="💰" FontSize="18" VerticalOptions="Center" />
                            <Label FontFamily="NunitoBold" FontSize="13.5" TextColor="{DynamicResource GoldTextDeep}"
                                   VerticalOptions="Center" MaximumWidthRequest="270"
                                   Text="{Binding PerUnitLine}" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <controls:ChunkyButton Grid.Row="1" Margin="20,12,20,18" Text="Continue"
                                       Command="{Binding NextCommand}" Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 4 · Quit date (1e) ══ -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=4}">
                <VerticalStackLayout Grid.Row="0" Padding="24,18,24,0" Spacing="8">
                    <Label Text="When is day one?" Style="{StaticResource H1}" FontSize="28" />
                    <Label Text="Already stopped? Great. Planning ahead? Even better."
                           FontFamily="Nunito" FontSize="15" TextColor="{DynamicResource Muted}" />

                    <controls:SegmentedControl Margin="0,14,0,0" Option1="I already quit" Option2="Pick a future date"
                                               SelectedIndex="{Binding QuitModeIndex}" />

                    <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 20" Padding="16" Margin="0,12,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                <Label Grid.Column="0" Text="{Binding CalendarTitle}" FontFamily="NunitoBlack" FontSize="15"
                                       TextColor="{DynamicResource Ink}" />
                                <Label Grid.Column="1" Text="‹" FontFamily="NunitoBlack" FontSize="16" TextColor="{DynamicResource Faint}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding PrevMonthCommand}" /></Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="2" Text="›" FontFamily="NunitoBlack" FontSize="16" TextColor="{DynamicResource Faint}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding NextMonthCommand}" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,4,0,2">
                                <Label Grid.Column="0" Text="M" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="T" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="W" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="T" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="4" Text="F" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="5" Text="S" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="6" Text="S" Style="{StaticResource FaintLabel}" FontSize="11" HorizontalTextAlignment="Center" />
                            </Grid>
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding QuitCalendar}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid FlexLayout.Basis="14.28%" HeightRequest="36" Padding="1">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="Transparent" IsVisible="{Binding HasDay}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectDayCommand, Source={x:Reference Root}}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Selected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#14B36B" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Text}" FontFamily="NunitoBold" FontSize="13.5"
                                                       HorizontalOptions="Center" VerticalOptions="Center"
                                                       TextColor="{DynamicResource Ink}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Selected}" Value="True">
                                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Border Grid.Column="0" Style="{StaticResource Card}" StrokeShape="RoundRectangle 16" Padding="16,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TIME" Style="{StaticResource FaintLabel}" FontSize="11" />
                                <TimePicker Time="{Binding QuitTime}" Format="HH:mm" FontFamily="NunitoBlack"
                                            FontSize="18" TextColor="{DynamicResource Ink}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource Mint}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" Padding="16,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="THAT MAKES TODAY" FontFamily="NunitoExtraBold" FontSize="11"
                                       CharacterSpacing="0.5" TextColor="#4E8A70" />
                                <Label Text="{Binding QuitDayLabel}" FontFamily="NunitoBlack" FontSize="18"
                                       TextColor="{DynamicResource PrimaryText}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
                <controls:ChunkyButton Grid.Row="1" Margin="20,12,20,18" Text="Continue"
                                       Command="{Binding NextCommand}" Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 5 · Motivation (1f) ══ -->
            <Grid RowDefinitions="*,Auto"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=5}">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="24,18,24,0" Spacing="8">
                        <Label Text="Why are you quitting?" Style="{StaticResource H1}" FontSize="28" />
                        <Label Text="Pick any that fit. We’ll show these back to you when cravings hit."
                               FontFamily="Nunito" FontSize="15" TextColor="{DynamicResource Muted}" />

                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" Margin="0,16,0,0"
                                    BindableLayout.ItemsSource="{Binding MotivationOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border FlexLayout.Basis="47%" Margin="0,0,0,12" StrokeThickness="1.5"
                                            Stroke="{DynamicResource CardBorder}" BackgroundColor="{DynamicResource Card}"
                                            StrokeShape="RoundRectangle 18" Padding="14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.ToggleMotivationCommand, Source={x:Reference Root}}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Selected}" Value="True">
                                                <Setter Property="Stroke" Value="#14B36B" />
                                                <Setter Property="StrokeThickness" Value="2.5" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="8">
                                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                                        BackgroundColor="{Binding IconBg}" StrokeShape="RoundRectangle 13"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding Emoji}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <Label Text="{Binding Label}" FontFamily="NunitoExtraBold" FontSize="14.5"
                                                       TextColor="{DynamicResource Ink}" />
                                            </VerticalStackLayout>
                                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" BackgroundColor="#14B36B"
                                                    StrokeShape="RoundRectangle 11" HorizontalOptions="End" VerticalOptions="Start"
                                                    IsVisible="{Binding Selected}">
                                                <Label Text="✓" FontFamily="NunitoBlack" FontSize="12" TextColor="White"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 16" Padding="14,4"
                                IsVisible="{Binding MotivationOptions[5].Selected}">
                            <Entry Text="{Binding OwnReason}" Placeholder="What's your reason?"
                                   FontFamily="NunitoBold" TextColor="{DynamicResource Ink}" />
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
                <controls:ChunkyButton Grid.Row="1" Margin="20,12,20,18" Text="Continue"
                                       Command="{Binding NextCommand}" Fill="#14B36B" ShadowColor="#0E8A50" />
            </Grid>

            <!-- ══ 6 · Summary (1g) ══ -->
            <Grid BackgroundColor="#14B36B"
                  IsVisible="{Binding Step, Converter={StaticResource IsStep}, ConverterParameter=6}">
                <controls:ConfettiView />
                <Grid RowDefinitions="*,Auto" Padding="24,0,24,18">
                    <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center">
                        <controls:PuffMascot Diameter="88" Expression="Happy" Float="True" HorizontalOptions="Center" />
                        <Label Text="Here’s what quitting&#10;gives you back" FontFamily="NunitoBlack" FontSize="27"
                               TextColor="White" HorizontalTextAlignment="Center" Margin="0,18,0,0" />

                        <Border BackgroundColor="#26FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                Padding="24,20" Margin="0,20,0,0" HorizontalOptions="Fill">
                            <VerticalStackLayout>
                                <Label Text="IN ONE YEAR" FontFamily="NunitoExtraBold" FontSize="13" CharacterSpacing="1" TextColor="#BDF0D4" />
                                <Label Text="{Binding YearSaveStr}" FontFamily="NunitoBlack" FontSize="44" TextColor="White" />
                                <Label Text="{Binding YearUnitsLine}"
                                       FontFamily="NunitoBold" FontSize="14" TextColor="#D9F5E6" Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                            <Border Grid.Column="0" BackgroundColor="#26FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                                <VerticalStackLayout>
                                    <Label Text="PER WEEK" FontFamily="NunitoExtraBold" FontSize="11" CharacterSpacing="1" TextColor="#BDF0D4" />
                                    <Label Text="{Binding WeekSaveStr}" FontFamily="NunitoBlack" FontSize="22" TextColor="White" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#26FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14">
                                <VerticalStackLayout>
                                    <Label Text="PER MONTH" FontFamily="NunitoExtraBold" FontSize="11" CharacterSpacing="1" TextColor="#BDF0D4" />
                                    <Label Text="{Binding MonthSaveStr}" FontFamily="NunitoBlack" FontSize="22" TextColor="White" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Slips won’t erase your progress. We count everything you keep."
                               FontFamily="NunitoBold" FontSize="14" TextColor="#D9F5E6"
                               HorizontalTextAlignment="Center" Margin="0,16,0,0" />
                    </VerticalStackLayout>

                    <controls:ChunkyButton Grid.Row="1" Text="Start my quit 🎉" Command="{Binding FinishCommand}"
                                           Fill="White" ShadowColor="#12000000" TextColor="#0E8A50" ButtonHeight="60" />
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
