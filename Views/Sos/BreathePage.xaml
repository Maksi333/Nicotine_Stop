<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Nicotine_Stop.Views.Sos.BreathePage"
             BackgroundColor="#232140"
             NavigationPage.HasNavigationBar="False">

    <Grid Padding="22,0,22,18" RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="0,10,0,0">
            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                    BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 19">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBack" /></Border.GestureRecognizers>
                <Label Text="‹" FontFamily="NunitoExtraBold" FontSize="18" TextColor="#B9B4E3"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="4 · 7 · 8 BREATHING" FontFamily="NunitoBlack" FontSize="14"
                   CharacterSpacing="1" TextColor="#B9B4E3" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
            <Grid WidthRequest="280" HeightRequest="280" HorizontalOptions="Center">
                <Grid x:Name="BreathVisual" Scale="0.55">
                    <Border WidthRequest="280" HeightRequest="280" StrokeThickness="0" BackgroundColor="#248B7CF6"
                            StrokeShape="RoundRectangle 140" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border WidthRequest="210" HeightRequest="210" StrokeThickness="0" BackgroundColor="#388B7CF6"
                            StrokeShape="RoundRectangle 105" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border WidthRequest="140" HeightRequest="140" StrokeThickness="0" BackgroundColor="#8B7CF6"
                            StrokeShape="RoundRectangle 70" HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                    <Label x:Name="PhaseLabel" Text="Breathe in" FontFamily="NunitoBlack" FontSize="22"
                           TextColor="White" HorizontalTextAlignment="Center" />
                    <Label x:Name="CountLabel" Text="4" FontFamily="NunitoBlack" FontSize="40" TextColor="White"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout x:Name="Dots" Spacing="8" HorizontalOptions="Center" Margin="0,34,0,0">
                <BoxView x:Name="Dot1" WidthRequest="26" HeightRequest="10" CornerRadius="5" Color="#8B7CF6" />
                <BoxView x:Name="Dot2" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#40FFFFFF" />
                <BoxView x:Name="Dot3" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#40FFFFFF" />
                <BoxView x:Name="Dot4" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#40FFFFFF" />
            </HorizontalStackLayout>

            <Label x:Name="CycleLabel" Text="Cycle 1 of 4 · in 4s → hold 7s → out 8s" FontFamily="NunitoExtraBold"
                   FontSize="13" TextColor="#B9B4E3" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
        </VerticalStackLayout>

        <Border Grid.Row="2" HeightRequest="52" StrokeThickness="0" BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 16">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOkay" /></Border.GestureRecognizers>
            <Label Text="The craving passed — I'm okay" FontFamily="NunitoBlack" FontSize="15" TextColor="#E4E0FB"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
