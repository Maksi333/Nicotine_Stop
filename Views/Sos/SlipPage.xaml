<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Nicotine_Stop.Controls"
             x:Class="Nicotine_Stop.Views.Sos.SlipPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="22,0,22,18" Spacing="0">

            <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0" HorizontalOptions="Start" Margin="0,10,0,0"
                    BackgroundColor="{DynamicResource Mint}" StrokeShape="RoundRectangle 19">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBack" /></Border.GestureRecognizers>
                <Label Text="‹" FontFamily="NunitoExtraBold" FontSize="18" TextColor="{DynamicResource Muted}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Slips happen." Style="{StaticResource H2}" Margin="0,10,0,0" />
            <Label Text="What matters is what you do next. This is data, not failure." FontFamily="Nunito"
                   FontSize="14.5" TextColor="{DynamicResource Muted}" Margin="0,6,0,0" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
                <Border Grid.Column="0" StrokeThickness="2" Stroke="#BDE5CF" BackgroundColor="{DynamicResource Mint}"
                        StrokeShape="RoundRectangle 18" Padding="14,13">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✓ YOU KEEP" FontFamily="NunitoBlack" FontSize="11" CharacterSpacing="1" TextColor="{DynamicResource PrimaryText}" />
                        <Label x:Name="KeepLabel" FontFamily="NunitoExtraBold" FontSize="13" LineHeight="1.5" TextColor="{DynamicResource Ink}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeThickness="2" Stroke="#FFD1CC" BackgroundColor="{DynamicResource CoralTint}"
                        StrokeShape="RoundRectangle 18" Padding="14,13">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="↺ ONLY THIS RESETS" FontFamily="NunitoBlack" FontSize="11" CharacterSpacing="1" TextColor="{DynamicResource CoralText}" />
                        <Label x:Name="ResetLabel" FontFamily="NunitoExtraBold" FontSize="13" LineHeight="1.5" TextColor="{DynamicResource Ink}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="WHAT TRIGGERED IT?  (optional)" Style="{StaticResource Overline}" Margin="0,16,0,0" />
            <FlexLayout x:Name="Chips" Wrap="Wrap" Margin="0,8,0,0" />

            <Border StrokeThickness="1.5" Stroke="{DynamicResource CardBorder}" BackgroundColor="{DynamicResource Card}"
                    StrokeShape="RoundRectangle 16" Padding="14,10" Margin="0,14,0,0" MinimumHeightRequest="74">
                <Editor x:Name="NoteEditor" Placeholder="Add a note — where were you, how did it feel…"
                        FontFamily="NunitoBold" FontSize="13.5" TextColor="{DynamicResource Ink}"
                        BackgroundColor="Transparent" HeightRequest="60" />
            </Border>

            <controls:ChunkyButton x:Name="LogBtn" Text="Log it &amp; keep going" Margin="0,16,0,0"
                                   Fill="#17322B" ShadowColor="#0A1A14" />
            <Label Text="Never mind — I didn't slip" FontFamily="NunitoExtraBold" FontSize="13"
                   TextColor="{DynamicResource Faint}" HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBack" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
