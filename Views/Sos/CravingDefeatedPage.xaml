<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Nicotine_Stop.Controls"
             x:Class="Nicotine_Stop.Views.Sos.CravingDefeatedPage"
             BackgroundColor="#14B36B"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <controls:ConfettiView />
        <Grid RowDefinitions="*,Auto" Padding="24,0,24,18">
            <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                <controls:PuffMascot Diameter="120" Expression="Happy" Float="True" HorizontalOptions="Center" />
                <Label Text="Craving defeated!" FontFamily="NunitoBlack" FontSize="32" TextColor="White"
                       HorizontalTextAlignment="Center" Margin="0,22,0,0" />
                <Label x:Name="SubLabel" FontFamily="NunitoBold" FontSize="15" TextColor="#D9F5E6"
                       HorizontalTextAlignment="Center" Margin="0,10,0,0" MaximumWidthRequest="300" />
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
                    <Border x:Name="XpChip" StrokeThickness="0" BackgroundColor="#29FFFFFF" StrokeShape="RoundRectangle 16" Padding="20,12">
                        <VerticalStackLayout>
                            <Label x:Name="XpLabel" FontFamily="NunitoBlack" FontSize="22" TextColor="White" />
                            <Label Text="CRAVING WON" FontFamily="NunitoExtraBold" FontSize="11" TextColor="#BDF0D4" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeThickness="0" BackgroundColor="#29FFFFFF" StrokeShape="RoundRectangle 16" Padding="20,12">
                        <VerticalStackLayout>
                            <Label x:Name="WinsLabel" FontFamily="NunitoBlack" FontSize="22" TextColor="White" />
                            <Label Text="TOTAL WINS" FontFamily="NunitoExtraBold" FontSize="11" TextColor="#BDF0D4" />
                        </VerticalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <controls:ChunkyButton Grid.Row="1" x:Name="BackBtn" Text="Back to my day" ButtonHeight="58"
                                   Fill="White" ShadowColor="#12000000" TextColor="#0E8A50" />
        </Grid>
    </Grid>
</ContentPage>
